---
import { brand, footer } from "../content/copy.ts";

/*
  Footer minimale: wordmark, tagline, copyright, disclaimer Meta/Google,
  contatto email.

  Niente link legali: /aviso-legal e /privacidad sono stub DRAFT noindex e
  non vanno linkati finché non arriva il legal pack (linkarli li esporrebbe
  ai crawler nonostante il noindex, e mostrerebbe testo non definitivo).
*/
---

<footer class="border-t border-[var(--color-ink)]/10">
  <div class="mx-auto max-w-4xl px-6 py-10 sm:px-8 sm:py-12">
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        {
          brand.logoSrc ? (
            <img
              src={brand.logoSrc}
              alt={brand.name}
              width={brand.logoWidth}
              height={brand.logoHeight}
              class="h-10 w-auto sm:h-[46px]"
            />
          ) : (
            /* Slot logo vuoto (vedi `brand` in copy.ts): wordmark testuale
               finché non arriva l'artwork del brand nuovo. */
            <p class="text-lg font-[var(--font-fraunces)] font-semibold tracking-tight text-[var(--color-ink)] sm:text-xl">
              {brand.name}
            </p>
          )
        }
        <p class="mt-3 max-w-sm text-sm text-[var(--color-muted)]">
          {footer.tagline}
        </p>
        <p class="mt-2 text-sm text-[var(--color-muted)]">
          <a
            href={`mailto:${footer.email}`}
            class="underline underline-offset-2 transition-colors hover:text-[var(--color-ink)]"
          >
            {footer.email}
          </a>
        </p>
      </div>

      <p class="text-xs text-[var(--color-muted)]/80 sm:text-right">
        {footer.copyright}
      </p>
    </div>

    <p
      class="mt-8 border-t border-[var(--color-ink)]/10 pt-6 text-xs leading-snug text-[var(--color-muted)]/70"
    >
      {footer.disclaimer}
    </p>
  </div>
</footer>
