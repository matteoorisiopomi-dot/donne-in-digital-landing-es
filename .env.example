# Copy this file to .env and fill in the real values. .env is git-ignored.
# Never commit real keys. On Vercel these live in
# Project -> Settings -> Environment Variables.
#
# ALL VALUES ARE INTENTIONALLY EMPTY HERE. Every integration degrades
# gracefully when its variable is missing (see the notes below), so the
# site builds and runs locally with this file copied verbatim.

# --- Canonical site URL (build time) ---
# Used for canonical URLs, absolute og:url and sitemap.xml.
# Empty locally = the placeholder fallback in astro.config.mjs
# ("https://example-PLACEHOLDER.invalid") is used.
# TODO (go-live): the Spanish market domain does not exist yet. Once it is
# registered, set this in Vercel to the final domain, redeploy production,
# and uncomment the Sitemap line in public/robots.txt.
PUBLIC_SITE_URL=

# --- Meta Pixel + Conversions API ---
# Browser-visible (PUBLIC_ prefix required).
# EMPTY => src/components/tracking/Pixel.astro emits NO markup at all:
# no fbq snippet, no PageView, no network call. The Lead/VSL/Form_Visible
# event helpers become silent no-ops (they check `typeof fbq`).
PUBLIC_META_PIXEL_ID=

# Server-only (no prefix, never exposed to the client).
# Generated in Business Manager -> Events Manager.
# EMPTY (either one) => api/lead.ts logs
# "[lead] CAPI skipped: missing META_CAPI_DATASET_ID or ACCESS_TOKEN"
# and returns without firing anything. The Slack notification and the
# 200 response to the client are unaffected — CAPI is best-effort.
META_CAPI_ACCESS_TOKEN=
META_CAPI_DATASET_ID=

# Optional: test code from Events Manager -> Test Events, during dev only.
# When set it is added as `test_event_code` to the CAPI payload.
META_CAPI_TEST_EVENT_CODE=

# --- Lead notification ---
# Slack incoming webhook URL for the leads channel.
# EMPTY => api/lead.ts responds 503 { error: "config_missing" } and logs a
# warning with the lead email. The client still redirects to /gracias:
# the user never sees an internal error, but THE LEAD IS LOST. Set this
# before sending any paid traffic.
SLACK_WEBHOOK_URL=

# --- Local test scripts only (never set on Vercel) ---
# scripts/test-pixel-events.mjs fires REAL events at the pixel of whatever
# deployment you point it to. Both values are required and have no default,
# so the script can never hit another market's site or dataset by accident:
#   TEST_TARGET_URL   deployment to test (falls back to PUBLIC_SITE_URL)
#   TEST_VSL=1        also check VSL_Play / VSL_25 / VSL_50 / VSL_75 —
#                     only meaningful once vsl.video leaves "placeholder"
TEST_TARGET_URL=
TEST_VSL=
